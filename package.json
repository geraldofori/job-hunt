{
  "name": "job-hunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "ats:run": "tsx workers/run-ats.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "discovery": "tsx --env-file=.env.local workers/run-discovery.ts",
    "stepstone:run": "tsx --env-file=.env.local workers/run-stepstone.ts",
    "contacts:run": "tsx --env-file=.env.local workers/run-contacts.ts",
    "linkedin:login": "tsx --env-file=.env.local workers/linkedin-login.ts",
    "daily": "tsx --env-file=.env.local workers/run-daily.ts",
    "brief": "tsx --env-file=.env.local -e \"import(\"./src/server/monitoring/brief.ts\").then(m => m.buildBrief().then(b => console.log(b.markdown)))\""
  },
  "dependencies": {
    "better-sqlite3": "^12.4.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.1",
    "googleapis": "^189.0.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.8",
    "playwright": "^1.65.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
